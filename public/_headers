# Prevent caching of the main entry points so users always get the latest version immediately
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Allow aggressive caching of static assets with unique hashed names (Vite build outputs)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
