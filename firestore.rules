rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Test Path
    match /test/connection {
      allow read: if true;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    
    // Core Identity Helpers
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.email == 'crucify87@gmail.com' ||
        getUserData().status == 'approved'
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'crucify87@gmail.com' ||
        getUserData().role == 'super_admin'
      );
    }
    
    function isAdminUser() {
      return isSuperAdmin() || (isApproved() && getUserData().role == 'admin');
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email == request.auth.token.email &&
             (!data.keys().hasAny(['role']) || data.role in ['super_admin', 'admin', 'viewer']) &&
             (!data.keys().hasAny(['status']) || data.status in ['approved', 'pending', 'rejected']);
    }

    // --- Collections ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Users can create their own profile. Default role/status handled by app logic but rules allow basic sync.
      // However, we must prevent users from elevating their own role/status.
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    (!incoming().keys().hasAny(['role', 'status']) || request.auth.token.email == 'crucify87@gmail.com');
      
      allow update: if isSignedIn() && (
        // Super Admin can change anything
        isSuperAdmin() ||
        // User can change their own basic info (not role/status)
        (request.auth.uid == userId && 
         !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status']))
      );
      
      allow delete: if isSuperAdmin();
    }

    // 2. Inventory Collection
    match /inventory/{itemId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminUser() && isEmailVerified();
    }

    // 3. Production Batches
    match /production_batches/{batchId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminUser() && isEmailVerified();
    }

    // 4. Logistics
    match /logistics/{recordId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminUser() && isEmailVerified();
    }

    // 5. Partners
    match /partners/{partnerId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdminUser() && isEmailVerified();
    }

    // 6. Admin Emails (Legacy, keeping for compatibility if needed, but primary logic is in /users)
    match /admin_emails/{email} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }
  }
}
